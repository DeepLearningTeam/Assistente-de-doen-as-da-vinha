# Copiar para .env. Não colocar .env no Git.
# Ollama é uma opção local para o LLM; requer a instalação separada do Ollama e um modelo compatível com tool calling.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ESCOLHER_E_TESTAR_MODELO_LOCAL

# Modelos/índice — preencher depois de decidir as versões no grupo.
EMBEDDING_MODEL=BAAI/bge-m3
VLM_MODEL=ESCOLHER_MODELO_VLM
INDEX_DIR=data/index/faiss
PDF_DIR=data/docs
